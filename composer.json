{
    "name": "manageitwa/payg-tax",
    "description": "Calculate PAYG tax withholding amounts for employees",
    "type": "library",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Ben Thomson",
            "email": "ben@manageit.com.au"
        }
    ],
    "require": {
        "php": "^8.2",
        "nesbot/carbon": "^3.8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "squizlabs/php_codesniffer": "4.*",
        "rector/rector": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "ManageIt\\PaygTax\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ManageIt\\PaygTax\\Tests\\": "tests/"
        }
    }
